# =========================================
# Hollo Stream Proxy
# - WebSocket /api/v1/streaming (Mastodon互換)
# - WebPush Subscription API /api/v1/push/subscription
# - Instance API proxy (/api/v1/instance, /api/v2/instance)
# - Filters endpoint (/api/v1/filters)
# - Hollo REST API をポーリング
# =========================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hollo-stream-proxy
  namespace: <NAMESPACE>
  labels:
    app: hollo-stream-proxy
    role: stream
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: hollo-stream-proxy
      role: stream
  template:
    metadata:
      labels:
        app: hollo-stream-proxy
        role: stream
    spec:
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: hollo-stream-proxy-data
      containers:
        - name: stream-proxy
          image: ghcr.io/ntsklab/hollo-stream-proxy:0.13.9
          imagePullPolicy: IfNotPresent
          # ConfigMap / Secret の全キーを環境変数として一括注入
          envFrom:
            - configMapRef:
                name: cm-hollo-stream-proxy
            - secretRef:
                name: vapid-keys
          resources:
            limits:
              cpu: "2000m"
              memory: "256Mi"
            requests:
              cpu: "100m"
              memory: "64Mi"
          ports:
            - containerPort: 3001
          volumeMounts:
            - name: data
              mountPath: /data
          startupProbe:
            httpGet:
              path: /health
              port: 3001
            initialDelaySeconds: 5
            periodSeconds: 2
            timeoutSeconds: 2
            successThreshold: 1
            failureThreshold: 15
          livenessProbe:
            httpGet:
              path: /health
              port: 3001
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /health
              port: 3001
            initialDelaySeconds: 30
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 3
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cm-hollo-stream-proxy
  namespace: <NAMESPACE>
data:
  HOLLO_URL: "https://your-instance.example.com"
  HOLLO_INTERNAL_URL: "http://hollo.<NAMESPACE>.svc.cluster.local:3000"
  POLL_INTERVAL: "3000"
  VAPID_SUBJECT: "https://your-instance.example.com"
  DATA_DIR: "/data"
  PORT: "3001"
  # --- Optional: security hardening / tuning (defaults shown; uncomment to enable) ---
  # PUBLIC_URL: "https://stream.example.com"
  # ALLOWED_ORIGINS: "https://app1.example.com,https://app2.example.com"
  # WS_MAX_PAYLOAD: "65536"
  # WS_MAX_CONNECTIONS: "1000"
  # WS_MAX_MESSAGES_PER_MINUTE: "60"
  # MAX_BODY_BYTES: "65536"
  # TOKEN_CACHE_MAX_ENTRIES: "1000"
---
apiVersion: v1
kind: Service
metadata:
  name: hollo-stream-proxy
  namespace: <NAMESPACE>
spec:
  type: ClusterIP
  selector:
    app: hollo-stream-proxy
    role: stream
  ports:
    - name: http
      protocol: TCP
      port: 3001
      targetPort: 3001
---
apiVersion: v1
kind: Secret
metadata:
  name: vapid-keys
  namespace: <NAMESPACE>
type: Opaque
stringData:
  # Generate with: node gen-vapid-keys.mjs
  VAPID_PUBLIC_KEY: "<generate with gen-vapid-keys.mjs>"
  VAPID_PRIVATE_KEY: "<generate with gen-vapid-keys.mjs>"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: hollo-stream-proxy-data
  namespace: <NAMESPACE>
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
